Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 100
NamespaceIndentation: None
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterNamespace: false
  AfterClass: false
  AfterStruct: false
  AfterEnum: false
  AfterControlStatement: Never
  BeforeElse: false
  BeforeCatch: false
SortIncludes: true
